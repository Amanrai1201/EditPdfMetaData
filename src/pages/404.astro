---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { toolPages, learnPages } from "../data/nav";
---

<Layout
  title="Page Not Found — PDF Metadata Editor"
  description="That page doesn't exist. Jump to the PDF metadata viewer, editor, or remover instead."
  path="/404"
  noindex
>
  <Nav />

  <main id="main" class="relative overflow-hidden">
    <div
      class="pointer-events-none absolute inset-x-0 -top-48 h-[28rem] mesh-gradient opacity-35 dark:opacity-25"
      aria-hidden="true"
    >
    </div>
    <div
      class="pointer-events-none absolute inset-0 bg-gradient-to-b from-transparent via-canvas/50 to-canvas"
      aria-hidden="true"
    >
    </div>

    <div class="container-page relative py-20 sm:py-28">
      <p class="font-mono text-caption uppercase tracking-widest text-mute">Error 404</p>
      <h1 class="mt-3 max-w-2xl text-display-lg text-ink sm:text-display-xl text-balance">
        That page doesn't exist.
      </h1>
      <p class="mt-5 max-w-xl text-body-lg text-body">
        The link may be out of date, or there may be a typo in the address. Everything the
        site does is one click away below.
      </p>

      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a href="/" class="btn btn-primary">Back to the home page</a>
        <a href="/edit-pdf-metadata" class="btn btn-secondary">Open the editor</a>
      </div>

      <div class="mt-16 grid grid-cols-1 gap-10 sm:grid-cols-2">
        <div>
          <p class="eyebrow">Tools</p>
          <ul class="mt-4 space-y-3 border-t border-hairline pt-4">
            {
              toolPages.map((t) => (
                <li>
                  <a href={t.href} class="group block">
                    <span class="text-body-md font-medium text-ink group-hover:text-link">
                      {t.label}
                    </span>
                    <span class="mt-0.5 block text-body-sm text-body">{t.blurb}</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>

        <div>
          <p class="eyebrow">Learn</p>
          <ul class="mt-4 space-y-3 border-t border-hairline pt-4">
            {
              learnPages.map((t) => (
                <li>
                  <a href={t.href} class="group block">
                    <span class="text-body-md font-medium text-ink group-hover:text-link">
                      {t.label}
                    </span>
                    <span class="mt-0.5 block text-body-sm text-body">{t.blurb}</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </main>

  <Footer />
</Layout>
