---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import PageHeader from "../components/PageHeader.astro";
import Faq from "../components/Faq.astro";
import CtaBand from "../components/CtaBand.astro";
import RelatedPages from "../components/RelatedPages.astro";
import Footer from "../components/Footer.astro";
import { faqs, faqCategories, faqSchema } from "../data/faqs";

const path = "/faq";
const crumbs = [{ label: "FAQ", href: path }];

const counts = faqCategories.map((c) => ({
  cat: c,
  n: faqs.filter((f) => f.cat === c).length,
}));
---

<Layout
  title="PDF Metadata FAQ — Questions About Viewing, Editing & Removing"
  description="Answers to common questions about PDF metadata: what it contains, which fields you can edit, how removal works, whether files are uploaded, and what to do when a PDF won't open."
  path={path}
  breadcrumbs={crumbs}
  schema={[faqSchema(faqs)]}
>
  <Nav />
  <Breadcrumbs items={crumbs} />

  <main id="main">
    <PageHeader
      eyebrow="FAQ"
      title="Questions about PDF metadata, answered properly."
      intro={`${faqs.length} questions covering the basics, using the editor, privacy, and what to do when something doesn't work. If your question isn't here, the field reference probably covers it.`}
    />

    <!-- Category overview -->
    <section class="border-b border-hairline bg-surface py-8">
      <div class="container-page">
        <p class="eyebrow">Categories</p>
        <ul class="mt-3 flex flex-wrap gap-x-6 gap-y-2">
          {
            counts.map((c) => (
              <li class="text-body-sm text-body">
                <span class="font-medium text-ink">{c.cat}</span>
                <span class="ml-1.5 font-mono text-caption text-mute">{c.n}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <Faq
      variant="all"
      eyebrow="All questions"
      title="Everything people ask us."
      moreLink={false}
    />

    <!-- Still stuck -->
    <section class="py-16 sm:py-20">
      <div class="container-page">
        <div class="mx-auto max-w-3xl rounded-lg border border-hairline bg-surface-2/50 p-6 sm:p-8">
          <h2 class="text-display-sm text-ink">Didn't find your answer?</h2>
          <p class="mt-3 text-body-md text-body">
            The three pages below go deeper than an FAQ answer can. The field reference in
            particular lists every property a PDF can carry, what it usually contains, and
            how identifying it is.
          </p>
          <ul class="mt-6 space-y-2.5">
            {
              [
                { href: "/what-is-pdf-metadata", label: "What is PDF metadata? — the concepts, in plain English" },
                { href: "/pdf-metadata-fields", label: "Field reference — every property, one by one" },
                { href: "/how-it-works", label: "How it works — the mechanism, including why nothing uploads" },
              ].map((l) => (
                <li>
                  <a
                    href={l.href}
                    class="inline-flex items-center gap-2 text-body-md text-link underline decoration-link/30 underline-offset-4 hover:decoration-link"
                  >
                    {l.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>

    <CtaBand
      title="Or just try it."
      body="Load a PDF and see what it says about itself. Nothing leaves your device."
      href="/view-pdf-metadata"
      cta="Open the viewer"
    />

    <RelatedPages exclude={[path]} />
  </main>

  <Footer />
</Layout>
