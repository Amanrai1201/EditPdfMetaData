---
import { toolPages, learnPages, type NavItem } from "../data/nav";

interface Props {
  title?: string;
  /** Hrefs to exclude — normally the current page. */
  exclude?: string[];
  /** Which pools to draw from. */
  pool?: "tools" | "learn" | "all";
  limit?: number;
}

const {
  title = "Keep exploring",
  exclude = [],
  pool = "all",
  limit = 4,
} = Astro.props;

const source: NavItem[] =
  pool === "tools" ? toolPages : pool === "learn" ? learnPages : [...toolPages, ...learnPages];

const items = source.filter((i) => !exclude.includes(i.href)).slice(0, limit);
---

<section class="border-t border-hairline py-14 sm:py-16">
  <div class="container-page">
    <h2 class="text-display-sm text-ink">{title}</h2>
    <ul class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        items.map((i) => (
          <li>
            <a
              href={i.href}
              class="card group flex h-full flex-col p-5 transition-shadow hover:shadow-float"
            >
              <span class="text-body-sm font-semibold text-ink">{i.label}</span>
              <span class="mt-1.5 flex-1 text-body-sm text-body">{i.blurb}</span>
              <span class="mt-4 inline-flex items-center gap-1.5 text-body-sm font-medium text-link">
                Open
                <svg class="h-4 w-4 transition-transform group-hover:translate-x-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
