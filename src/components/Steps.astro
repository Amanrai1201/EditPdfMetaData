---
interface Props {
  title?: string;
  eyebrow?: string;
}
const { title = "Three steps, zero uploads.", eyebrow = "How it works" } = Astro.props;

const steps = [
  {
    n: "01",
    title: "Drop in your PDF",
    body: "Drag a file onto the editor or browse for it. The file is read straight into your browser's memory — it is never sent anywhere.",
  },
  {
    n: "02",
    title: "View and edit the fields",
    body: "Every metadata field appears in an editable form. Change what you need, clear a field to delete it, or add your own custom properties.",
  },
  {
    n: "03",
    title: "Download your copy",
    body: "Save the edited PDF, or strip all metadata in one click. Your original file stays exactly as it was — you always get a new copy.",
  },
];
---

<section class="py-16 sm:py-24">
  <div class="container-page">
    <div class="mx-auto max-w-2xl text-center">
      <p class="eyebrow">{eyebrow}</p>
      <h2 class="mt-2 text-display-md text-ink sm:text-display-lg">{title}</h2>
    </div>

    <ol class="mt-12 grid grid-cols-1 gap-6 md:grid-cols-3">
      {
        steps.map((s) => (
          <li>
            <span class="font-mono text-caption text-mute">{s.n}</span>
            <div class="mt-3 border-t-2 border-hairline pt-4">
              <h3 class="text-display-sm text-ink">{s.title}</h3>
              <p class="mt-2 text-body-sm text-body">{s.body}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>
