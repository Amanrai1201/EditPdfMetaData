---
import { toolPages, learnPages, companyPages, legalPages } from "../data/nav";

const year = new Date().getFullYear();
const contactEmail = "support@editpdfmetadata.com";
---

<footer class="border-t border-hairline bg-canvas py-14">
  <div class="container-page">
    <div class="flex flex-col gap-10 lg:flex-row lg:justify-between">
      <div class="max-w-sm">
        <a href="/" class="flex items-center gap-2.5" aria-label="EditPdfMetaData home">
          <img src="/favicon.svg" alt="" width="26" height="26" class="rounded-md" />
          <span class="text-body-sm font-semibold tracking-tight text-ink">EditPdfMetaData</span>
        </a>
        <p class="mt-4 text-body-sm text-body">
          A free, private tool to view, edit, and remove metadata from PDF files —
          entirely in your browser.
        </p>
        <p class="mt-4 font-mono text-caption text-mute">
          <a href={`mailto:${contactEmail}`} class="transition-colors hover:text-ink">{contactEmail}</a>
        </p>
      </div>

      <div class="grid grid-cols-2 gap-x-10 gap-y-10 sm:grid-cols-4">
        <div>
          <p class="eyebrow">Tools</p>
          <ul class="mt-4 space-y-2.5">
            {
              toolPages.map((t) => (
                <li>
                  <a href={t.href} class="text-body-sm text-body transition-colors hover:text-ink">
                    {t.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
        <div>
          <p class="eyebrow">Learn</p>
          <ul class="mt-4 space-y-2.5">
            {
              learnPages.map((l) => (
                <li>
                  <a href={l.href} class="text-body-sm text-body transition-colors hover:text-ink">
                    {l.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
        <div>
          <p class="eyebrow">Company</p>
          <ul class="mt-4 space-y-2.5">
            {
              companyPages.map((c) => (
                <li>
                  <a href={c.href} class="text-body-sm text-body transition-colors hover:text-ink">
                    {c.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
        <div>
          <p class="eyebrow">Legal</p>
          <ul class="mt-4 space-y-2.5">
            {
              legalPages.map((l) => (
                <li>
                  <a href={l.href} class="text-body-sm text-body transition-colors hover:text-ink">
                    {l.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>

    <div
      class="mt-12 flex flex-col gap-3 border-t border-hairline pt-6 sm:flex-row sm:items-center sm:justify-between"
    >
      <p class="text-caption text-mute">© {year} EditPdfMetaData. All rights reserved.</p>
      <p class="flex items-center gap-1.5 text-caption text-mute">
        <span class="inline-block h-1.5 w-1.5 rounded-full bg-success"></span>
        No files uploaded · no tracking · no cookies
      </p>
    </div>
  </div>
</footer>
