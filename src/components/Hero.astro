---
import { toolPages } from "../data/nav";

const trust = ["No uploads", "No tracking", "No file-size limit", "Works offline"];
---

<section class="relative overflow-hidden border-b border-hairline">
  <!-- Signature mesh gradient — hero scale only -->
  <div
    class="pointer-events-none absolute inset-x-0 -top-40 h-[36rem] mesh-gradient opacity-55 dark:opacity-35"
    aria-hidden="true"
  >
  </div>
  <div
    class="pointer-events-none absolute inset-x-0 top-0 h-full bg-gradient-to-b from-transparent via-canvas/40 to-canvas"
    aria-hidden="true"
  >
  </div>

  <div class="container-page relative flex flex-col items-center py-20 text-center sm:py-28">
    <span class="badge">
      <span class="inline-block h-1.5 w-1.5 rounded-full bg-success"></span>
      100% client-side · nothing leaves your device
    </span>

    <h1 class="mt-6 max-w-3xl text-display-lg text-ink sm:text-display-xl text-balance">
      Edit PDF metadata online view, change, or remove it in your browser.
    </h1>

    <p class="mt-5 max-w-2xl text-body-lg text-body text-pretty">
      A free PDF metadata editor and viewer. Change the title, author, subject,
      keywords, and dates on any PDF, or strip every trace of metadata in one click.
      Your files are processed entirely on your device and never uploaded, tracked,
      or stored.
    </p>

    <div class="mt-8 flex flex-col items-center gap-3 sm:flex-row">
      <a href="#editor" class="btn btn-primary text-base h-12 px-6">Open the editor</a>
      <a href="/how-it-works" class="btn btn-secondary text-base h-12 px-6">See how it works</a>
    </div>

    <ul class="mt-9 flex flex-wrap items-center justify-center gap-x-5 gap-y-2">
      {
        trust.map((t) => (
          <li class="flex items-center gap-1.5 text-body-sm text-mute">
            <svg class="h-4 w-4 text-success" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5" /></svg>
            {t}
          </li>
        ))
      }
    </ul>

    <!-- Task entry points — one indexable page per intent -->
    <!-- <ul class="mt-14 grid w-full max-w-4xl grid-cols-1 gap-4 text-left sm:grid-cols-3">
      {
        toolPages.map((t) => (
          <li>
            <a
              href={t.href}
              class="card group flex h-full flex-col p-5 transition-shadow hover:shadow-float"
            >
              <span class="text-body-md font-semibold text-ink">{t.label}</span>
              <span class="mt-1.5 flex-1 text-body-sm text-body">{t.blurb}</span>
              <span class="mt-4 inline-flex items-center gap-1.5 text-body-sm font-medium text-link">
                Open
                <svg class="h-4 w-4 transition-transform group-hover:translate-x-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
              </span>
            </a>
          </li>
        ))
      }
    </ul> -->
  </div>
</section>
