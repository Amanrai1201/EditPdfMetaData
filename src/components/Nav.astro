---
import { toolPages, learnPages } from "../data/nav";

const path = Astro.url.pathname.replace(/\/+$/, "") || "/";
const isActive = (href: string) => path === href.replace(/\/+$/, "");
const inTools = toolPages.some((t) => isActive(t.href));
const inLearn = learnPages.some((l) => isActive(l.href));
---

<header class="sticky top-0 z-50 border-b border-hairline bg-canvas/85 backdrop-blur-md">
  <nav class="container-page flex h-16 items-center justify-between gap-4" aria-label="Main">
    <a href="/" class="flex shrink-0 items-center gap-2.5" aria-label="EditPdfMetaData home">
      <img src="/favicon.svg" alt="" width="28" height="28" class="rounded-md" />
      <span class="hidden text-body-sm font-semibold tracking-tight text-ink sm:inline">
        EditPdfMetaData
      </span>
    </a>

    <!-- Desktop nav -->
    <ul class="hidden items-center gap-1 lg:flex">
      <!-- Tools dropdown -->
      <li class="group relative">
        <button
          type="button"
          class:list={[
            "flex items-center gap-1.5 rounded-full px-3 py-1.5 text-body-sm transition-colors hover:bg-surface-2 hover:text-ink",
            inTools ? "text-ink font-medium" : "text-body",
          ]}
          aria-expanded="false"
          aria-haspopup="true"
        >
          Tools
          <svg class="h-3.5 w-3.5 transition-transform group-hover:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
        </button>
        <div
          class="invisible absolute left-0 top-full w-72 pt-2 opacity-0 transition-[opacity,visibility] group-focus-within:visible group-focus-within:opacity-100 group-hover:visible group-hover:opacity-100"
        >
          <ul class="card overflow-hidden p-1.5" style="box-shadow: var(--shadow-modal)">
            {
              toolPages.map((t) => (
                <li>
                  <a
                    href={t.href}
                    class:list={[
                      "block rounded-md px-3 py-2.5 transition-colors hover:bg-surface-2",
                      isActive(t.href) && "bg-surface-2",
                    ]}
                  >
                    <span class="block text-body-sm font-medium text-ink">{t.label}</span>
                    <span class="mt-0.5 block text-caption text-mute">{t.blurb}</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </li>

      <!-- Learn dropdown -->
      <li class="group relative">
        <button
          type="button"
          class:list={[
            "flex items-center gap-1.5 rounded-full px-3 py-1.5 text-body-sm transition-colors hover:bg-surface-2 hover:text-ink",
            inLearn ? "text-ink font-medium" : "text-body",
          ]}
          aria-expanded="false"
          aria-haspopup="true"
        >
          Learn
          <svg class="h-3.5 w-3.5 transition-transform group-hover:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
        </button>
        <div
          class="invisible absolute left-0 top-full w-72 pt-2 opacity-0 transition-[opacity,visibility] group-focus-within:visible group-focus-within:opacity-100 group-hover:visible group-hover:opacity-100"
        >
          <ul class="card overflow-hidden p-1.5" style="box-shadow: var(--shadow-modal)">
            {
              learnPages.map((l) => (
                <li>
                  <a
                    href={l.href}
                    class:list={[
                      "block rounded-md px-3 py-2.5 transition-colors hover:bg-surface-2",
                      isActive(l.href) && "bg-surface-2",
                    ]}
                  >
                    <span class="block text-body-sm font-medium text-ink">{l.label}</span>
                    <span class="mt-0.5 block text-caption text-mute">{l.blurb}</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </li>
    </ul>

    <!-- Right cluster -->
    <div class="flex items-center gap-2">
      <button
        id="theme-toggle"
        type="button"
        class="grid h-9 w-9 place-items-center rounded-full border border-hairline text-ink transition-colors hover:bg-surface-2"
        aria-label="Toggle dark mode"
      >
        <svg class="h-4 w-4 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
        <svg class="hidden h-4 w-4 dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path></svg>
      </button>

      <a href="/edit-pdf-metadata" class="btn btn-primary btn-sm hidden sm:inline-flex">
        Open editor
      </a>

      <button
        id="menu-toggle"
        type="button"
        class="grid h-9 w-9 place-items-center rounded-full border border-hairline text-ink transition-colors hover:bg-surface-2 lg:hidden"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg id="menu-open-icon" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
        <svg id="menu-close-icon" class="hidden h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>
      </button>
    </div>
  </nav>

  <!-- Mobile menu -->
  <div id="mobile-menu" hidden class="border-t border-hairline bg-canvas lg:hidden">
    <div class="container-page max-h-[calc(100dvh-4rem)] overflow-y-auto py-5">
      <p class="eyebrow">Tools</p>
      <ul class="mt-3 space-y-1">
        {
          toolPages.map((t) => (
            <li>
              <a
                href={t.href}
                class:list={[
                  "block rounded-md px-3 py-2.5 text-body-sm transition-colors hover:bg-surface-2",
                  isActive(t.href) ? "bg-surface-2 font-medium text-ink" : "text-body",
                ]}
              >
                {t.label}
              </a>
            </li>
          ))
        }
      </ul>

      <p class="eyebrow mt-6">Learn</p>
      <ul class="mt-3 space-y-1">
        {
          learnPages.map((l) => (
            <li>
              <a
                href={l.href}
                class:list={[
                  "block rounded-md px-3 py-2.5 text-body-sm transition-colors hover:bg-surface-2",
                  isActive(l.href) ? "bg-surface-2 font-medium text-ink" : "text-body",
                ]}
              >
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>

      <a href="/edit-pdf-metadata" class="btn btn-primary mt-6 w-full">Open editor</a>
    </div>
  </div>
</header>

<script>
  document.getElementById("theme-toggle")?.addEventListener("click", () => {
    const isDark = document.documentElement.classList.toggle("dark");
    try {
      localStorage.setItem("theme", isDark ? "dark" : "light");
    } catch (_) {}
  });

  const menuBtn = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");
  const openIcon = document.getElementById("menu-open-icon");
  const closeIcon = document.getElementById("menu-close-icon");

  menuBtn?.addEventListener("click", () => {
    const open = menu?.hasAttribute("hidden");
    if (open) menu?.removeAttribute("hidden");
    else menu?.setAttribute("hidden", "");
    menuBtn.setAttribute("aria-expanded", String(!!open));
    menuBtn.setAttribute("aria-label", open ? "Close menu" : "Open menu");
    openIcon?.classList.toggle("hidden", !!open);
    closeIcon?.classList.toggle("hidden", !open);
  });
</script>
