---
interface Props {
  eyebrow: string;
  title: string;
  intro: string;
  /** Small reassurance chips under the intro. */
  chips?: string[];
  /** Render the signature mesh gradient behind the header. */
  mesh?: boolean;
}
const { eyebrow, title, intro, chips = [], mesh = false } = Astro.props;
---

<section class="relative overflow-hidden border-b border-hairline">
  {
    mesh && (
      <>
        <div
          class="pointer-events-none absolute inset-x-0 -top-48 h-[32rem] mesh-gradient opacity-45 dark:opacity-30"
          aria-hidden="true"
        />
        <div
          class="pointer-events-none absolute inset-0 bg-gradient-to-b from-transparent via-canvas/50 to-canvas"
          aria-hidden="true"
        />
      </>
    )
  }

  <div class="container-page relative py-14 sm:py-20">
    <div class="max-w-3xl">
      <p class="eyebrow">{eyebrow}</p>
      <h1 class="mt-3 text-display-lg text-ink sm:text-display-xl text-balance">{title}</h1>
      <p class="mt-5 max-w-2xl text-body-lg text-body text-pretty">{intro}</p>

      {
        chips.length > 0 && (
          <ul class="mt-7 flex flex-wrap items-center gap-x-5 gap-y-2">
            {chips.map((c) => (
              <li class="flex items-center gap-1.5 text-body-sm text-mute">
                <svg class="h-4 w-4 text-success" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
                {c}
              </li>
            ))}
          </ul>
        )
      }

      <slot />
    </div>
  </div>
</section>
