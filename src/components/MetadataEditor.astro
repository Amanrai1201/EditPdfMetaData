---
// Client-side PDF metadata editor. All logic runs in the browser <script> below;
// no server, no upload. pdf-lib is dynamically imported on first file load.
---

<section id="editor" class="scroll-mt-20 py-16 sm:py-24">
  <div class="container-page">
    <div class="mx-auto max-w-4xl">
      <div class="mb-8 text-center">
        <p class="eyebrow">The tool</p>
        <h2 class="mt-2 text-display-md text-ink sm:text-display-lg">PDF Metadata Editor</h2>
        <p class="mx-auto mt-3 max-w-xl text-body-md text-body">
          Drop a PDF to inspect and edit its metadata. Everything runs locally — your
          file never leaves this page.
        </p>
      </div>

      <div class="card overflow-hidden">
        <!-- ───────── DROP STATE ───────── -->
        <div id="drop-state" class="p-4 sm:p-6">
          <div
            id="dropzone"
            role="button"
            tabindex="0"
            aria-label="Choose a PDF file or drop one here"
            class="group flex flex-col items-center justify-center rounded-lg border-2 border-dashed border-hairline-strong/50 bg-surface-2/40 px-6 py-14 text-center transition-colors hover:border-link hover:bg-link-soft/20 focus-visible:focus-ring"
          >
            <span
              class="grid h-14 w-14 place-items-center rounded-full bg-surface text-ink shadow-card transition-transform group-hover:-translate-y-0.5"
            >
              <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 16V4M7 9l5-5 5 5"/><path d="M4 16v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2"/></svg>
            </span>
            <p class="mt-4 text-body-md font-medium text-ink">
              Drag &amp; drop your PDF, or <span class="text-link">browse</span>
            </p>
            <p class="mt-1 text-body-sm text-mute">
              No size limit · processed entirely on your device
            </p>
          </div>
          <input id="file-input" type="file" accept="application/pdf,.pdf" class="sr-only" />
          <p
            id="error-msg"
            role="alert"
            hidden
            class="mt-4 rounded-md border border-error/30 bg-error-soft px-4 py-3 text-body-sm text-error-deep"
          >
          </p>
        </div>

        <!-- ───────── EDITOR STATE ───────── -->
        <div id="editor-state" hidden>
          <!-- File info bar -->
          <div
            class="flex flex-wrap items-center gap-x-5 gap-y-3 border-b border-hairline bg-surface-2/50 px-4 py-3.5 sm:px-6"
          >
            <div class="flex min-w-0 items-center gap-2.5">
              <svg class="h-5 w-5 shrink-0 text-link" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 3v4a1 1 0 0 0 1 1h4"/><path d="M17 21H7a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h7l5 5v11a2 2 0 0 1-2 2z"/></svg>
              <span id="fi-name" class="truncate text-body-sm font-medium text-ink" title=""></span>
            </div>
            <dl class="flex flex-wrap items-center gap-x-4 gap-y-1 text-body-sm text-mute">
              <div class="flex items-center gap-1.5"><dt class="sr-only">Size</dt><dd id="fi-size"></dd></div>
              <div class="flex items-center gap-1.5"><dt class="text-hairline-strong">·</dt><dd id="fi-pages"></dd></div>
              <div class="flex items-center gap-1.5"><dt class="text-hairline-strong">·</dt><dd>PDF <span id="fi-version"></span></dd></div>
            </dl>
            <span id="fi-enc" hidden class="badge border-warning/40 bg-warning-soft text-warning-deep">
              <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="11" width="18" height="10" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
              Encrypted
            </span>
            <button id="btn-newfile" type="button" class="btn btn-ghost btn-sm ml-auto">
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><path d="M17 8l-5-5-5 5"/><path d="M12 3v12"/></svg>
              Load a different file
            </button>
          </div>

          <div class="p-4 sm:p-6">
            <!-- Standard metadata -->
            <p class="eyebrow">Standard metadata</p>
            <div class="mt-3 grid grid-cols-1 gap-4 sm:grid-cols-2">
              <div class="sm:col-span-2">
                <label class="field-label" for="f-title">Title</label>
                <input id="f-title" class="field-input" type="text" placeholder="Document title" />
              </div>
              <div>
                <label class="field-label" for="f-author">Author</label>
                <input id="f-author" class="field-input" type="text" placeholder="e.g. Jane Doe" />
              </div>
              <div>
                <label class="field-label" for="f-subject">Subject</label>
                <input id="f-subject" class="field-input" type="text" placeholder="What the document is about" />
              </div>
              <div class="sm:col-span-2">
                <label class="field-label" for="f-keywords">Keywords</label>
                <input id="f-keywords" class="field-input" type="text" placeholder="comma, separated, keywords" />
              </div>
              <div>
                <label class="field-label" for="f-creator">Creator <span class="font-normal text-mute">— app that authored it</span></label>
                <input id="f-creator" class="field-input" type="text" placeholder="e.g. Microsoft Word" />
              </div>
              <div>
                <label class="field-label" for="f-producer">Producer <span class="font-normal text-mute">— app that made the PDF</span></label>
                <input id="f-producer" class="field-input" type="text" placeholder="e.g. macOS Quartz PDFContext" />
              </div>
              <div>
                <label class="field-label" for="f-created">Creation date</label>
                <div class="flex gap-2">
                  <input id="f-created" class="field-input" type="datetime-local" />
                  <button type="button" data-datenow="f-created" class="btn btn-secondary btn-sm shrink-0" title="Set to now">Now</button>
                </div>
              </div>
              <div>
                <label class="field-label" for="f-modified">Modification date</label>
                <div class="flex gap-2">
                  <input id="f-modified" class="field-input" type="datetime-local" />
                  <button type="button" data-datenow="f-modified" class="btn btn-secondary btn-sm shrink-0" title="Set to now">Now</button>
                </div>
              </div>
              <div>
                <label class="field-label" for="f-trapped">Trapped</label>
                <select id="f-trapped" class="field-input">
                  <option value="">— not set —</option>
                  <option value="True">True</option>
                  <option value="False">False</option>
                  <option value="Unknown">Unknown</option>
                </select>
              </div>
            </div>

            <!-- Custom properties -->
            <div class="mt-8 flex items-center justify-between">
              <p class="eyebrow">Custom properties</p>
              <button id="add-custom" type="button" class="btn btn-secondary btn-sm">
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
                Add property
              </button>
            </div>
            <div id="custom-fields" class="mt-3 space-y-2.5"></div>
            <p id="custom-empty" class="mt-3 text-body-sm text-mute">
              No custom properties. Add your own key/value pairs (e.g. <span class="font-mono text-body">Department</span>, <span class="font-mono text-body">CaseNumber</span>).
            </p>

            <!-- XMP -->
            <div id="xmp-block" hidden class="mt-8">
              <details class="rounded-md border border-hairline bg-surface-2/40">
                <summary class="cursor-pointer select-none px-4 py-3 text-body-sm font-medium text-ink">
                  <span class="eyebrow">XMP metadata</span>
                  <span class="ml-2 font-normal text-mute">— read-only preview. Use “Remove all metadata” to strip it.</span>
                </summary>
                <pre id="xmp-content" class="max-h-72 overflow-auto border-t border-hairline px-4 py-3 text-code text-body"></pre>
              </details>
            </div>

            <!-- Change review -->
            <div id="diff-panel" hidden class="mt-8 rounded-md border border-link/25 bg-link-soft/25 px-4 py-3">
              <p class="text-body-sm font-medium text-ink">
                <span id="diff-count">0</span> pending change<span id="diff-plural">s</span>
              </p>
              <ul id="diff-list" class="mt-2 space-y-1 text-body-sm text-body"></ul>
            </div>

            <!-- Actions -->
            <div class="mt-8 flex flex-col gap-3 border-t border-hairline pt-6 sm:flex-row sm:flex-wrap sm:items-center">
              <button id="btn-download" type="button" class="btn btn-primary">
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12M7 10l5 5 5-5"/><path d="M5 21h14"/></svg>
                Download edited PDF
              </button>
              <button id="btn-strip" type="button" class="btn btn-danger">
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6h18M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/></svg>
                Remove all metadata
              </button>
              <div class="flex gap-3 sm:ml-auto">
                <button id="btn-export" type="button" class="btn btn-secondary btn-sm">Export JSON</button>
                <button id="btn-import" type="button" class="btn btn-secondary btn-sm">Import JSON</button>
                <button id="btn-reset" type="button" class="btn btn-ghost btn-sm">Reset</button>
              </div>
              <input id="file-import" type="file" accept="application/json,.json" class="sr-only" />
            </div>
          </div>
        </div>
      </div>

      <p class="mt-4 text-center text-body-sm text-mute">
        Tip: after downloading, your file explorer may still show the old values from its cache.
        Re-open the PDF to confirm the change.
      </p>
    </div>
  </div>

  <!-- Custom-property row template -->
  <template id="custom-row-tpl">
    <div class="custom-row grid grid-cols-1 gap-2 sm:grid-cols-[1fr_1.4fr_auto]">
      <input class="field-input custom-key" type="text" placeholder="Property name" aria-label="Property name" />
      <input class="field-input custom-value" type="text" placeholder="Value" aria-label="Property value" />
      <button type="button" class="custom-remove btn btn-ghost btn-sm text-error" aria-label="Remove property">
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>
      </button>
    </div>
  </template>
</section>

<script>
  import type { PDFDocument as PDFDocumentType } from "pdf-lib";

  type Meta = {
    title: string; author: string; subject: string; keywords: string;
    creator: string; producer: string; created: string; modified: string;
    trapped: string; custom: { key: string; value: string }[];
  };

  const STD_KEYS = new Set([
    "Title", "Author", "Subject", "Keywords", "Creator",
    "Producer", "CreationDate", "ModDate", "Trapped",
  ]);
  const TRAPPED_VALUES = new Set(["True", "False", "Unknown"]);

  // ── Element refs ──────────────────────────────────────────────
  const $ = <T extends HTMLElement = HTMLElement>(id: string) =>
    document.getElementById(id) as T;

  const dropState = $("drop-state");
  const editorState = $("editor-state");
  const dropzone = $("dropzone");
  const fileInput = $<HTMLInputElement>("file-input");
  const errorMsg = $("error-msg");
  const customFields = $("custom-fields");
  const customEmpty = $("custom-empty");
  const rowTpl = $<HTMLTemplateElement>("custom-row-tpl");
  const diffPanel = $("diff-panel");
  const diffCount = $("diff-count");
  const diffList = $("diff-list");
  const fileImport = $<HTMLInputElement>("file-import");

  const F = {
    title: $<HTMLInputElement>("f-title"),
    author: $<HTMLInputElement>("f-author"),
    subject: $<HTMLInputElement>("f-subject"),
    keywords: $<HTMLInputElement>("f-keywords"),
    creator: $<HTMLInputElement>("f-creator"),
    producer: $<HTMLInputElement>("f-producer"),
    created: $<HTMLInputElement>("f-created"),
    modified: $<HTMLInputElement>("f-modified"),
    trapped: $<HTMLSelectElement>("f-trapped"),
  };

  // ── State ─────────────────────────────────────────────────────
  let pdfjsLib: typeof import("pdf-lib") | null = null;
  let currentBytes: Uint8Array | null = null;
  let currentName = "document.pdf";
  let originalMeta: Meta | null = null;

  // ── Helpers ───────────────────────────────────────────────────
  const fmtBytes = (n: number) => {
    if (n < 1024) return `${n} B`;
    if (n < 1024 * 1024) return `${(n / 1024).toFixed(1)} KB`;
    return `${(n / 1024 / 1024).toFixed(2)} MB`;
  };

  const pad = (n: number) => String(n).padStart(2, "0");
  const dateToInput = (d?: Date | null) => {
    if (!d || isNaN(d.getTime())) return "";
    return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}T${pad(d.getHours())}:${pad(d.getMinutes())}`;
  };
  const inputToDate = (v: string) => {
    if (!v) return null;
    const d = new Date(v);
    return isNaN(d.getTime()) ? null : d;
  };

  const readVersion = (bytes: Uint8Array) => {
    let head = "";
    for (let i = 0; i < Math.min(bytes.length, 1024); i++) head += String.fromCharCode(bytes[i]);
    const m = head.match(/%PDF-(\d\.\d)/);
    return m ? m[1] : "—";
  };

  const decodeName = (name: any) =>
    typeof name?.decodeText === "function"
      ? name.decodeText()
      : String(name).replace(/^\//, "");
  const decodeValue = (val: any) => {
    try {
      if (typeof val?.decodeText === "function") return val.decodeText();
      if (typeof val?.asString === "function") return val.asString().replace(/^\//, "");
    } catch (_) {}
    return "";
  };

  const infoDictOf = (doc: any) => {
    const ref = doc.context.trailerInfo?.Info;
    return ref ? doc.context.lookup(ref) : null;
  };

  const showError = (msg: string) => {
    errorMsg.textContent = msg;
    errorMsg.hidden = false;
  };

  // ── Read metadata from a loaded document ──────────────────────
  function extractMeta(doc: PDFDocumentType): Meta {
    const meta: Meta = {
      title: doc.getTitle() ?? "",
      author: doc.getAuthor() ?? "",
      subject: doc.getSubject() ?? "",
      keywords: doc.getKeywords() ?? "",
      creator: doc.getCreator() ?? "",
      producer: doc.getProducer() ?? "",
      created: dateToInput(doc.getCreationDate()),
      modified: dateToInput(doc.getModificationDate()),
      trapped: "",
      custom: [],
    };
    const dict: any = infoDictOf(doc as any);
    if (dict && typeof dict.entries === "function") {
      for (const [name, value] of dict.entries()) {
        const key = decodeName(name);
        if (key === "Trapped") {
          const t = decodeValue(value);
          meta.trapped = TRAPPED_VALUES.has(t) ? t : "";
          continue;
        }
        if (STD_KEYS.has(key)) continue;
        meta.custom.push({ key, value: decodeValue(value) });
      }
    }
    return meta;
  }

  async function readXmp(doc: any): Promise<string | null> {
    try {
      const { PDFName } = pdfjsLib!;
      const ref = doc.catalog.get(PDFName.of("Metadata"));
      if (!ref) return null;
      const stream = doc.context.lookup(ref);
      const bytes: Uint8Array = stream?.getContents?.() ?? stream?.contents;
      if (!bytes) return "present";
      const text = new TextDecoder("utf-8").decode(bytes);
      if (text.includes("<x:xmpmeta") || text.includes("<?xpacket") || text.includes("<rdf:RDF"))
        return text.trim();
      return "present"; // likely compressed / unreadable as text
    } catch (_) {
      return "present";
    }
  }

  // ── Populate form ─────────────────────────────────────────────
  function fillForm(meta: Meta) {
    F.title.value = meta.title;
    F.author.value = meta.author;
    F.subject.value = meta.subject;
    F.keywords.value = meta.keywords;
    F.creator.value = meta.creator;
    F.producer.value = meta.producer;
    F.created.value = meta.created;
    F.modified.value = meta.modified;
    F.trapped.value = meta.trapped;
    customFields.innerHTML = "";
    meta.custom.forEach((c) => addCustomRow(c.key, c.value));
    refreshCustomEmpty();
  }

  function addCustomRow(key = "", value = "") {
    const frag = rowTpl.content.cloneNode(true) as DocumentFragment;
    const row = frag.querySelector(".custom-row") as HTMLElement;
    (row.querySelector(".custom-key") as HTMLInputElement).value = key;
    (row.querySelector(".custom-value") as HTMLInputElement).value = value;
    row.querySelector(".custom-remove")!.addEventListener("click", () => {
      row.remove();
      refreshCustomEmpty();
      updateDiff();
    });
    row.addEventListener("input", updateDiff);
    customFields.appendChild(row);
    refreshCustomEmpty();
  }

  const refreshCustomEmpty = () => {
    customEmpty.hidden = customFields.children.length > 0;
  };

  // ── Read the form back into a Meta object ─────────────────────
  function formMeta(): Meta {
    const custom: { key: string; value: string }[] = [];
    customFields.querySelectorAll(".custom-row").forEach((row) => {
      const key = (row.querySelector(".custom-key") as HTMLInputElement).value.trim();
      const value = (row.querySelector(".custom-value") as HTMLInputElement).value;
      if (key) custom.push({ key, value });
    });
    return {
      title: F.title.value, author: F.author.value, subject: F.subject.value,
      keywords: F.keywords.value, creator: F.creator.value, producer: F.producer.value,
      created: F.created.value, modified: F.modified.value, trapped: F.trapped.value, custom,
    };
  }

  // ── Diff ──────────────────────────────────────────────────────
  const LABELS: Record<string, string> = {
    title: "Title", author: "Author", subject: "Subject", keywords: "Keywords",
    creator: "Creator", producer: "Producer", created: "Creation date",
    modified: "Modification date", trapped: "Trapped",
  };

  function updateDiff() {
    if (!originalMeta) return;
    const now = formMeta();
    const changes: string[] = [];
    (Object.keys(LABELS) as (keyof Meta)[]).forEach((k) => {
      if (String(originalMeta![k]) !== String(now[k]))
        changes.push(`${LABELS[k as string]}: “${originalMeta![k] || "—"}” → “${now[k] || "—"}”`);
    });
    const oc = JSON.stringify(originalMeta.custom);
    const nc = JSON.stringify(now.custom);
    if (oc !== nc) changes.push(`Custom properties updated (${now.custom.length} total)`);

    diffCount.textContent = String(changes.length);
    $("diff-plural").textContent = changes.length === 1 ? "" : "s";
    diffList.innerHTML = "";
    changes.forEach((c) => {
      const li = document.createElement("li");
      li.className = "flex gap-2";
      li.innerHTML = `<span class="text-link">•</span><span>${escapeHtml(c)}</span>`;
      diffList.appendChild(li);
    });
    diffPanel.hidden = changes.length === 0;
  }

  const escapeHtml = (s: string) =>
    s.replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]!));

  // ── Load a file ───────────────────────────────────────────────
  async function loadFile(file: File) {
    errorMsg.hidden = true;
    if (file.type && file.type !== "application/pdf" && !file.name.toLowerCase().endsWith(".pdf")) {
      showError("That doesn't look like a PDF. Please choose a .pdf file.");
      return;
    }
    try {
      if (!pdfjsLib) pdfjsLib = await import("pdf-lib");
      const { PDFDocument } = pdfjsLib;
      const bytes = new Uint8Array(await file.arrayBuffer());
      const doc = await PDFDocument.load(bytes, { ignoreEncryption: true, updateMetadata: false });

      currentBytes = bytes;
      currentName = file.name;
      originalMeta = extractMeta(doc);

      // File info
      $("fi-name").textContent = file.name;
      $("fi-name").setAttribute("title", file.name);
      $("fi-size").textContent = fmtBytes(file.size);
      $("fi-pages").textContent = `${doc.getPageCount()} page${doc.getPageCount() === 1 ? "" : "s"}`;
      $("fi-version").textContent = readVersion(bytes);
      $("fi-enc").hidden = !doc.isEncrypted;

      // XMP
      const xmp = await readXmp(doc as any);
      const xmpBlock = $("xmp-block");
      if (xmp && xmp !== "present") {
        xmpBlock.hidden = false;
        $("xmp-content").textContent = xmp;
      } else if (xmp === "present") {
        xmpBlock.hidden = false;
        $("xmp-content").textContent = "XMP metadata is present but stored in a compressed/binary form. It will be removed if you use “Remove all metadata”.";
      } else {
        xmpBlock.hidden = true;
      }

      fillForm(originalMeta);
      diffPanel.hidden = true;
      dropState.hidden = true;
      editorState.hidden = false;
      editorState.scrollIntoView({ behavior: "smooth", block: "start" });
    } catch (err) {
      console.error(err);
      showError("Couldn't read this PDF. It may be password-protected or corrupted.");
    }
  }

  // ── Build an edited PDF (or a fully stripped one) ─────────────
  async function buildPdf(strip: boolean): Promise<Uint8Array> {
    const { PDFDocument, PDFName, PDFHexString } = pdfjsLib!;
    const doc = await PDFDocument.load(currentBytes!, { ignoreEncryption: true, updateMetadata: false });

    if (strip) {
      const dict: any = infoDictOf(doc as any);
      if (dict?.entries) for (const [name] of [...dict.entries()]) dict.delete(name);
      doc.catalog.delete(PDFName.of("Metadata"));
      return doc.save({ updateMetadata: false });
    }

    const m = formMeta();
    const info: any = (doc as any).getInfoDict
      ? (doc as any).getInfoDict()
      : ensureInfoDict(doc);
    const set = (key: string, setter: () => void, value: string) => {
      if (value.trim()) setter();
      else info.delete(PDFName.of(key));
    };

    set("Title", () => doc.setTitle(m.title), m.title);
    set("Author", () => doc.setAuthor(m.author), m.author);
    set("Subject", () => doc.setSubject(m.subject), m.subject);
    set("Creator", () => doc.setCreator(m.creator), m.creator);
    set("Producer", () => doc.setProducer(m.producer), m.producer);
    set("Keywords", () => doc.setKeywords(m.keywords.split(/[,;]/).map((s) => s.trim()).filter(Boolean)), m.keywords);

    const cd = inputToDate(m.created);
    if (cd) doc.setCreationDate(cd); else info.delete(PDFName.of("CreationDate"));
    const md = inputToDate(m.modified);
    if (md) doc.setModificationDate(md); else info.delete(PDFName.of("ModDate"));

    if (m.trapped) info.set(PDFName.of("Trapped"), PDFName.of(m.trapped));
    else info.delete(PDFName.of("Trapped"));

    // Custom: clear existing non-standard keys, then re-add from form
    if (info.entries) {
      for (const [name] of [...info.entries()]) {
        const k = decodeName(name);
        if (!STD_KEYS.has(k)) info.delete(name);
      }
    }
    m.custom.forEach(({ key, value }) => {
      if (!STD_KEYS.has(key)) info.set(PDFName.of(key), PDFHexString.fromText(value));
    });

    return doc.save({ updateMetadata: false });
  }

  function ensureInfoDict(doc: any) {
    const existing = infoDictOf(doc);
    if (existing) return existing;
    const dict = doc.context.obj({});
    doc.context.trailerInfo.Info = doc.context.register(dict);
    return dict;
  }

  function download(bytes: Uint8Array, name: string) {
    const blob = new Blob([bytes], { type: "application/pdf" });
    const url = URL.createObjectURL(blob);
    const a = document.createElement("a");
    a.href = url;
    a.download = name;
    document.body.appendChild(a);
    a.click();
    a.remove();
    setTimeout(() => URL.revokeObjectURL(url), 2000);
  }

  const baseName = () => currentName.replace(/\.pdf$/i, "");

  // ── Wire up events ────────────────────────────────────────────
  dropzone.addEventListener("click", () => fileInput.click());
  dropzone.addEventListener("keydown", (e) => {
    if (e.key === "Enter" || e.key === " ") { e.preventDefault(); fileInput.click(); }
  });
  fileInput.addEventListener("change", () => {
    if (fileInput.files?.[0]) loadFile(fileInput.files[0]);
  });
  ["dragenter", "dragover"].forEach((ev) =>
    dropzone.addEventListener(ev, (e) => {
      e.preventDefault();
      dropzone.classList.add("border-link", "bg-link-soft/20");
    })
  );
  ["dragleave", "drop"].forEach((ev) =>
    dropzone.addEventListener(ev, (e) => {
      e.preventDefault();
      dropzone.classList.remove("border-link", "bg-link-soft/20");
    })
  );
  dropzone.addEventListener("drop", (e) => {
    const file = (e as DragEvent).dataTransfer?.files?.[0];
    if (file) loadFile(file);
  });

  // Live diff on any field change
  Object.values(F).forEach((el) => el.addEventListener("input", updateDiff));
  $("add-custom").addEventListener("click", () => { addCustomRow(); updateDiff(); });

  // Date "Now" buttons
  document.querySelectorAll<HTMLButtonElement>("[data-datenow]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const target = $(btn.dataset.datenow!) as HTMLInputElement;
      target.value = dateToInput(new Date());
      updateDiff();
    });
  });

  // Actions
  $("btn-newfile").addEventListener("click", () => {
    fileInput.value = "";
    dropState.hidden = false;
    editorState.hidden = true;
    currentBytes = null;
    dropState.scrollIntoView({ behavior: "smooth", block: "center" });
  });

  $("btn-reset").addEventListener("click", () => {
    if (originalMeta) { fillForm(originalMeta); updateDiff(); }
  });

  $<HTMLButtonElement>("btn-download").addEventListener("click", async () => {
    const btn = $<HTMLButtonElement>("btn-download");
    btn.disabled = true;
    try {
      const out = await buildPdf(false);
      download(out, `${baseName()}-edited.pdf`);
    } catch (err) {
      console.error(err);
      showEditorError("Could not save the PDF. See the console for details.");
    } finally {
      btn.disabled = false;
    }
  });

  $<HTMLButtonElement>("btn-strip").addEventListener("click", async () => {
    if (!confirm("Remove ALL metadata from this PDF? This clears every document property and the XMP packet. Your original file is untouched — a new copy is downloaded.")) return;
    const btn = $<HTMLButtonElement>("btn-strip");
    btn.disabled = true;
    try {
      const out = await buildPdf(true);
      download(out, `${baseName()}-no-metadata.pdf`);
    } catch (err) {
      console.error(err);
      showEditorError("Could not strip the PDF. See the console for details.");
    } finally {
      btn.disabled = false;
    }
  });

  function showEditorError(msg: string) {
    alert(msg);
  }

  // Export / import JSON
  $("btn-export").addEventListener("click", () => {
    const data = JSON.stringify(formMeta(), null, 2);
    const blob = new Blob([data], { type: "application/json" });
    const url = URL.createObjectURL(blob);
    const a = document.createElement("a");
    a.href = url;
    a.download = `${baseName()}-metadata.json`;
    a.click();
    setTimeout(() => URL.revokeObjectURL(url), 2000);
  });

  $("btn-import").addEventListener("click", () => fileImport.click());
  fileImport.addEventListener("change", async () => {
    const file = fileImport.files?.[0];
    if (!file) return;
    try {
      const data = JSON.parse(await file.text()) as Partial<Meta>;
      const merged: Meta = { ...(originalMeta as Meta), ...data, custom: data.custom ?? [] };
      fillForm(merged);
      updateDiff();
    } catch (_) {
      showEditorError("That JSON file couldn't be parsed.");
    } finally {
      fileImport.value = "";
    }
  });
</script>
