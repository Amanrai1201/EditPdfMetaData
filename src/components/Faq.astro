---
import { faqs as allFaqs, homeFaqs, faqCategories, type Faq } from "../data/faqs";

interface Props {
  variant?: "home" | "all";
  eyebrow?: string;
  title?: string;
  /** Show the "read the full FAQ" link (home variant). */
  moreLink?: boolean;
  /** Narrow subset by category — used on topic pages. */
  only?: string[];
}

const {
  variant = "home",
  eyebrow = "FAQ",
  title = "Common questions about PDF metadata.",
  moreLink = variant === "home",
  only,
} = Astro.props;

const base: Faq[] = variant === "all" ? allFaqs : homeFaqs;
const list = only ? base.filter((f) => only.includes(f.cat)) : base;
const grouped = variant === "all" && !only;
---

<section class="border-t border-hairline bg-surface py-16 sm:py-24">
  <div class="container-page">
    <div class="mx-auto max-w-3xl">
      <div class="text-center">
        <p class="eyebrow">{eyebrow}</p>
        <h2 class="mt-2 text-display-md text-ink sm:text-display-lg">{title}</h2>
      </div>

      {
        grouped ? (
          <div class="mt-12 space-y-12">
            {faqCategories.map((cat) => {
              const items = allFaqs.filter((f) => f.cat === cat);
              return items.length > 0 ? (
                <div>
                  <h3 class="text-display-sm text-ink">{cat}</h3>
                  <div class="mt-4 divide-y divide-hairline border-y border-hairline">
                    {items.map((f) => (
                      <details class="group">
                        <summary class="flex cursor-pointer list-none items-start justify-between gap-4 py-5 text-body-md font-medium text-ink">
                          <span>{f.q}</span>
                          <svg class="mt-0.5 h-5 w-5 shrink-0 text-mute transition-transform group-open:rotate-45" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
                        </summary>
                        <p class="pb-5 pr-9 text-body-md text-body">{f.a}</p>
                      </details>
                    ))}
                  </div>
                </div>
              ) : null;
            })}
          </div>
        ) : (
          <div class="mt-12 divide-y divide-hairline border-y border-hairline">
            {list.map((f) => (
              <details class="group">
                <summary class="flex cursor-pointer list-none items-start justify-between gap-4 py-5 text-body-md font-medium text-ink">
                  <span>{f.q}</span>
                  <svg class="mt-0.5 h-5 w-5 shrink-0 text-mute transition-transform group-open:rotate-45" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
                </summary>
                <p class="pb-5 pr-9 text-body-md text-body">{f.a}</p>
              </details>
            ))}
          </div>
        )
      }

      {
        moreLink && (
          <div class="mt-10 text-center">
            <a
              href="/faq"
              class="inline-flex items-center gap-2 text-body-md font-medium text-link underline decoration-link/30 underline-offset-4 hover:decoration-link"
            >
              Read the full FAQ
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            </a>
          </div>
        )
      }
    </div>
  </div>
</section>
