---
import { features as allFeatures, homeFeatures, icons, type Feature } from "../data/features";

interface Props {
  variant?: "home" | "all";
  eyebrow?: string;
  title?: string;
  intro?: string;
  /** Show the "see all features" link (home variant). */
  moreLink?: boolean;
}

const {
  variant = "home",
  eyebrow = "Features",
  title = "Everything you need, nothing you don't.",
  intro = "A focused tool that does one job completely — no account, no watermarks, no upload queue, no daily limit.",
  moreLink = variant === "home",
} = Astro.props;

const list: Feature[] = variant === "all" ? allFeatures : homeFeatures;
---

<section class="border-y border-hairline bg-surface py-16 sm:py-24">
  <div class="container-page">
    <div class="max-w-2xl">
      <p class="eyebrow">{eyebrow}</p>
      <h2 class="mt-2 text-display-md text-ink sm:text-display-lg">{title}</h2>
      <p class="mt-4 text-body-lg text-body">{intro}</p>
    </div>

    <ul class="mt-12 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        list.map((f) => (
          <li class="card p-6 transition-shadow hover:shadow-float">
            <span class="grid h-10 w-10 place-items-center rounded-md bg-surface-2 text-ink">
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons[f.icon]} />
            </span>
            <h3 class="mt-4 text-body-md font-semibold text-ink">{f.title}</h3>
            <p class="mt-2 text-body-sm text-body">{f.body}</p>
          </li>
        ))
      }
    </ul>

    {
      moreLink && (
        <a
          href="/features"
          class="mt-10 inline-flex items-center gap-2 text-body-md font-medium text-link underline decoration-link/30 underline-offset-4 hover:decoration-link"
        >
          See all features in detail
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
      )
    }
  </div>
</section>
