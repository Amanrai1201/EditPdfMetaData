---
import "@fontsource-variable/inter";
import "@fontsource-variable/jetbrains-mono";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  path: string;
  /** Extra JSON-LD blocks for this page (WebApplication, FAQPage, Article…). */
  schema?: Record<string, unknown>[];
  /** Breadcrumb trail, excluding Home. */
  breadcrumbs?: { label: string; href: string }[];
  /** Keep the page out of search results (404 and similar). */
  noindex?: boolean;
  /** Comma-separated target terms for this page. */
  keywords?: string;
  /** og:type — "article" on the guide and reference pages. */
  ogType?: "website" | "article";
  /** Override the share card. Path is resolved against the site origin. */
  image?: string;
  /** Alt text for the share card. */
  imageAlt?: string;
}

const {
  title,
  description,
  path,
  schema = [],
  breadcrumbs = [],
  noindex = false,
  keywords = "edit pdf metadata, pdf metadata, pdf metadata editor, view pdf metadata, pdf metadata viewer, remove pdf metadata, pdf metadata remover, change pdf metadata, edit pdf metadata online",
  ogType = "website",
  image = "/og-image.png",
  imageAlt = "EditPdfMetaData — edit PDF metadata online, free. View, edit and remove PDF metadata entirely in your browser.",
} = Astro.props;

const SITE = "https://editpdfmetadata.com";
const SITE_NAME = "EditPdfMetaData";
const canonical = new URL(path, SITE).href;
const ogImage = new URL(image, SITE).href;

// Stable @id anchors so the page-level nodes can reference the site-level ones
// instead of repeating them.
const orgId = `${SITE}/#organization`;
const siteId = `${SITE}/#website`;
const breadcrumbId = `${canonical}#breadcrumb`;

const orgSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": orgId,
  name: SITE_NAME,
  url: SITE,
  logo: {
    "@type": "ImageObject",
    url: `${SITE}/icon-512.png`,
    width: 512,
    height: 512,
  },
  description:
    "Free browser-based tools to view, edit, and remove PDF metadata with no uploads and no tracking.",
};

const siteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": siteId,
  name: SITE_NAME,
  alternateName: "PDF Metadata Viewer & Remover",
  url: SITE,
  inLanguage: "en",
  publisher: { "@id": orgId },
  description:
    "Free browser-based tool to view, edit, and remove PDF metadata with no uploads.",
};

const breadcrumbSchema =
  breadcrumbs.length > 0
    ? {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        "@id": breadcrumbId,
        itemListElement: [
          { "@type": "ListItem", position: 1, name: "Home", item: SITE },
          ...breadcrumbs.map((b, i) => ({
            "@type": "ListItem",
            position: i + 2,
            name: b.label,
            item: new URL(b.href, SITE).href,
          })),
        ],
      }
    : null;

const pageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": canonical,
  url: canonical,
  name: title,
  description,
  inLanguage: "en",
  isPartOf: { "@id": siteId },
  primaryImageOfPage: { "@type": "ImageObject", url: ogImage },
  ...(breadcrumbSchema ? { breadcrumb: { "@id": breadcrumbId } } : {}),
};

const blocks = [
  orgSchema,
  siteSchema,
  ...(noindex ? [] : [pageSchema]),
  ...(breadcrumbSchema ? [breadcrumbSchema] : []),
  ...schema,
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <!-- Icons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#fafafa" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0a0a0a" media="(prefers-color-scheme: dark)" />
    <meta name="application-name" content={SITE_NAME} />
    <meta name="apple-mobile-web-app-title" content={SITE_NAME} />

    <!-- Primary meta -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content={SITE_NAME} />
    {!noindex && <link rel="canonical" href={canonical} />}
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    <meta
      name="robots"
      content={noindex
        ? "noindex, follow"
        : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"}
    />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <!-- No-flash theme init: runs before first paint -->
    <script is:inline>
      (() => {
        try {
          const stored = localStorage.getItem("theme");
          const dark =
            stored === "dark" ||
            (!stored && matchMedia("(prefers-color-scheme: dark)").matches);
          document.documentElement.classList.toggle("dark", dark);
        } catch (_) {}
      })();
    </script>

    {blocks.map((b) => <script type="application/ld+json" set:html={JSON.stringify(b)} />)}
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[60] focus:rounded-md focus:bg-primary focus:px-4 focus:py-2 focus:text-body-sm focus:text-on-primary"
      >Skip to content</a
    >
    <slot />
  </body>
</html>
